{
  "type": "object",
  "additionalProperties": false,
  "required": ["outcome", "summary", "changed_files", "checks", "criteria", "open_questions"],
  "properties": {
    "outcome": {"type": "string", "enum": ["done", "partial", "blocked"]},
    "summary": {"type": "string"},
    "changed_files": {"type": "array", "items": {"type": "string"}},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "passed", "note"],
        "properties": {
          "command": {"type": "string"},
          "passed": {"type": "boolean"},
          "note": {"type": "string"}
        }
      }
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "status", "evidence"],
        "properties": {
          "criterion": {"type": "string"},
          "status": {"type": "string", "enum": ["met", "unmet", "unverified"]},
          "evidence": {"type": "string"}
        }
      }
    },
    "open_questions": {"type": "array", "items": {"type": "string"}}
  }
}
